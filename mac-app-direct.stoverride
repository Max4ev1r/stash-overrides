name: Mac App Direct Guard
desc: Direct-route local Mac apps that commonly break under TUN/system proxy. Generated from this machine's installed applications.

rules:
  # Remote control, VPN, accelerators, and virtual machines.
  - PROCESS-NAME,ToDesk,DIRECT
  - PROCESS-PATH,/Applications/ToDesk.app/Contents/MacOS/ToDesk,DIRECT
  - PROCESS-NAME,ToDesk_Service,DIRECT
  - PROCESS-PATH,/Applications/ToDesk.app/Contents/MacOS/ToDesk_Service,DIRECT
  - PROCESS-NAME,ToDesk_Session_Proxy,DIRECT
  - PROCESS-PATH,/Applications/ToDesk.app/Contents/MacOS/ToDesk_Session_Proxy,DIRECT
  - DOMAIN-SUFFIX,todesk.com,DIRECT
  - DOMAIN-SUFFIX,youqu.com,DIRECT
  - PROCESS-NAME,SunloginClient,DIRECT
  - PROCESS-PATH,/Applications/SunloginClient.app/Contents/MacOS/SunloginClient,DIRECT
  - DOMAIN-SUFFIX,oray.com,DIRECT
  - DOMAIN-SUFFIX,sunlogin.oray.com,DIRECT
  - PROCESS-NAME,Tailscale,DIRECT
  - PROCESS-PATH,/Applications/Tailscale.app/Contents/MacOS/Tailscale,DIRECT
  - DOMAIN-SUFFIX,tailscale.com,DIRECT
  - DOMAIN-SUFFIX,ts.net,DIRECT
  - PROCESS-NAME,prl_client_app,DIRECT
  - PROCESS-PATH,/Applications/Parallels Desktop.app/Contents/MacOS/prl_client_app,DIRECT
