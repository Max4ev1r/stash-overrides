name: Mac App Direct Guard
desc: Minimal direct-route guard for domestic Mac apps. Browsers, global collaboration apps, Apple services, Microsoft apps, Steam, and proxy clients remain governed by the main subscription.

rules:
  # Remote control and accelerators.
  - PROCESS-NAME,ToDesk,DIRECT
  - PROCESS-NAME,ToDesk_Service,DIRECT
  - PROCESS-NAME,ToDesk_Session_Proxy,DIRECT
  - DOMAIN-SUFFIX,todesk.com,DIRECT
  - DOMAIN-SUFFIX,youqu.com,DIRECT
  - PROCESS-NAME,SunloginClient,DIRECT
  - DOMAIN-SUFFIX,oray.com,DIRECT
  - PROCESS-NAME,UURemote,DIRECT
  - PROCESS-NAME,UURemoteServer,DIRECT
  - PROCESS-NAME,雷神加速器,DIRECT
  - DOMAIN-SUFFIX,leigod.com,DIRECT

  # Domestic messaging and meetings.
  - PROCESS-NAME,WeChat,DIRECT
  - PROCESS-NAME,企业微信,DIRECT
  - PROCESS-NAME,QQ,DIRECT
  - PROCESS-NAME,TencentMeeting,DIRECT
  - DOMAIN-SUFFIX,weixin.qq.com,DIRECT
  - DOMAIN-SUFFIX,wechat.com,DIRECT
  - DOMAIN-SUFFIX,wecom.work,DIRECT
  - DOMAIN-SUFFIX,work.weixin.qq.com,DIRECT
  - DOMAIN-SUFFIX,tencentmeeting.com,DIRECT
  - DOMAIN-SUFFIX,voovmeeting.com,DIRECT

  # Domestic cloud, office, and device utilities.
  - PROCESS-NAME,BaiduNetdisk_mac,DIRECT
  - PROCESS-NAME,aDrive,DIRECT
  - PROCESS-NAME,wpsoffice,DIRECT
  - PROCESS-NAME,wpscloudsvr,DIRECT
  - PROCESS-NAME,小米互联服务,DIRECT
  - PROCESS-NAME,i4Tools,DIRECT
  - PROCESS-NAME,WeTypeInstaller,DIRECT
  - DOMAIN-SUFFIX,baidupcs.com,DIRECT
  - DOMAIN-SUFFIX,baidubce.com,DIRECT
  - DOMAIN-SUFFIX,aliyundrive.com,DIRECT
  - DOMAIN-SUFFIX,alicloudccp.com,DIRECT
  - DOMAIN-SUFFIX,wps.cn,DIRECT
  - DOMAIN-SUFFIX,kdocs.cn,DIRECT
  - DOMAIN-SUFFIX,xiaomi.com,DIRECT

  # Domestic media and app ecosystems.
  - PROCESS-NAME,NeteaseMusic,DIRECT
  - PROCESS-NAME,抖音,DIRECT
  - PROCESS-NAME,哔哩哔哩,DIRECT
  - PROCESS-NAME,QQLive,DIRECT
  - PROCESS-NAME,MuMuPlayer,DIRECT
  - DOMAIN-SUFFIX,music.163.com,DIRECT
  - DOMAIN-SUFFIX,douyin.com,DIRECT
  - DOMAIN-SUFFIX,bilibili.com,DIRECT
  - DOMAIN-SUFFIX,bilivideo.com,DIRECT
  - DOMAIN-SUFFIX,video.qq.com,DIRECT
